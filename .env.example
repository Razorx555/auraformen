# ─────────────────────────────────────────────────────────────
# AURA FOR MEN — configuração
# Copie para .env.local (local) ou cadastre na Vercel (produção).
# ─────────────────────────────────────────────────────────────

# URL pública do site (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.seudominio.com.br

# Modo da loja: "live" (vendas ativas) ou "prelaunch" (pré-lançamento)
NEXT_PUBLIC_STORE_MODE=live

# Data REAL de lançamento (ISO). Sem ela não há contagem regressiva.
# NEXT_PUBLIC_LAUNCH_DATE=2026-12-10T10:00:00-03:00

# "false" quando preço/estoque vierem da fonte oficial (remove selos de demonstração)
NEXT_PUBLIC_DEMO_COMMERCE=true

# Shopify Storefront API (checkout real)
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=
# SHOPIFY_API_VERSION=2025-10

# Newsletter / interesse no lançamento (webhook: Klaviyo, RD Station, Zapier, Make…)
NEXT_PUBLIC_NEWSLETTER_ENABLED=
NEWSLETTER_WEBHOOK_URL=

# Formulário de contato (webhook)
NEXT_PUBLIC_CONTACT_ENABLED=
CONTACT_WEBHOOK_URL=

# Dados institucionais (só aparecem quando preenchidos)
NEXT_PUBLIC_COMPANY_LEGAL_NAME=
NEXT_PUBLIC_COMPANY_CNPJ=
NEXT_PUBLIC_COMPANY_ADDRESS=
NEXT_PUBLIC_COMPANY_PHONE=
NEXT_PUBLIC_COMPANY_EMAIL=
NEXT_PUBLIC_COMPANY_WHATSAPP=
NEXT_PUBLIC_COMPANY_SERVICE_HOURS=

# Redes sociais (apenas URLs https reais)
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_TIKTOK=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
